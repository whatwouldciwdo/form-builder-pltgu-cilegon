// Prisma Schema for PLTGU Cilegon Form Builder

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  FORM_CREATOR
  RESPONDER
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(FORM_CREATOR)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  forms     Form[]
  responses FormResponse[]

  @@map("users")
}

model Form {
  id                  String   @id @default(uuid())
  userId              String
  title               String
  description         String?
  slug                String   @unique
  isPublished         Boolean  @default(false)
  isAcceptingResponse Boolean  @default(true)
  requiresLogin       Boolean  @default(false)
  successMessage      String   @default("Terima kasih! Respon formulir Anda telah berhasil kami terima.")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fields    FormField[]
  responses FormResponse[]

  @@map("forms")
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  EMAIL
  DATE
  DROPDOWN
  RADIO
  CHECKBOX
  FILE
  SIGNATURE
}

model FormField {
  id              String    @id @default(uuid())
  formId          String
  type            FieldType
  label           String
  placeholder     String?
  helpText        String?
  isRequired      Boolean   @default(false)
  order           Int       @default(0)
  options         Json?     // Array pilihan string untuk dropdown/radio/checkbox
  validationRules Json?     // Konfigurasi validasi tambahan (min, max, signatureFormat, dll)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  form    Form            @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers FormAnswer[]

  @@index([formId, order])
  @@map("form_fields")
}

model FormResponse {
  id            String   @id @default(uuid())
  formId        String
  respondentId  String?
  respondentIp  String?
  submittedAt   DateTime @default(now())
  metadata      Json?

  form       Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  respondent User?        @relation(fields: [respondentId], references: [id], onDelete: SetNull)
  answers    FormAnswer[]

  @@map("responses")
}

model FormAnswer {
  id         String   @id @default(uuid())
  responseId String
  fieldId    String
  value      String   @db.Text // Nilai isian text, JSON list, atau base64/URL tanda tangan
  createdAt  DateTime @default(now())

  response FormResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  field    FormField    @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@index([fieldId])
  @@map("answers")
}
